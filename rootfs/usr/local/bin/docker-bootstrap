#!/bin/bash

shopt -s nullglob

# supervisord gives programs a stdin pipe that never reaches EOF.
exec < /dev/null

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/docker-entrypoint.d"

source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/instance.sh"
source "${LIB_DIR}/services.sh"
source "${LIB_DIR}/freepbx.sh"
source "${LIB_DIR}/hooks.sh"

failed=0

# Keep going without Asterisk, as the entrypoint always did.
if ! wait_for_asterisk; then
    failed=1
fi

if [[ -f "${INSTALL_PENDING_FLAG}" ]]; then
    if [[ $failed -ne 0 ]]; then
        log "Warning: Asterisk is down; FreePBX install postponed to the next boot."
    elif ! install_pending; then
        log "Warning: ignoring ${INSTALL_PENDING_FLAG}: not owned by root."
        rm -f "${INSTALL_PENDING_FLAG}"
    elif freepbx_install "${INSTANCE_DIR}"; then
        rm -f "${INSTALL_PENDING_FLAG}"
    else
        log "Error: FreePBX install did not complete; will retry on next boot."
        failed=1
    fi
fi

run_bash_scripts "${HOOKS_DIR}"

fix_permissions "${INSTANCE_DIR}"

freepbx_post
ensure_fail2ban_channel "${INSTANCE_DIR}"

if ! start_apache; then
    log "Error: failed to start Apache."
    failed=1
fi

if [[ $failed -ne 0 ]]; then
    log "Bootstrap finished with errors."
    exit 1
fi

log "Bootstrap finished."
exit 0
