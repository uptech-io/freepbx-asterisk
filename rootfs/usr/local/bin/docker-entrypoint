#!/bin/bash

shopt -s nullglob

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LIB_DIR="${SCRIPT_DIR}/docker-entrypoint.d"

source "${LIB_DIR}/common.sh"
source "${LIB_DIR}/db.sh"
source "${LIB_DIR}/network.sh"
source "${LIB_DIR}/instance.sh"
source "${LIB_DIR}/odbc.sh"
source "${LIB_DIR}/ssmtp.sh"
source "${LIB_DIR}/services.sh"
source "${LIB_DIR}/freepbx.sh"
source "${LIB_DIR}/hooks.sh"

instance_directory="/data"
hooks="/data/entrypoint-hooks.d"

wait_for_db
add_extra_ips

prepare_instance "${instance_directory}"
restore_symlinks "${instance_directory}"

# Load the firewall before any service starts listening.
load_nftables_configs "${hooks}"

write_odbc_ini
write_ssmtp_ini

prepare_services

if install_pending; then
    prepare_database
    fix_permissions "${instance_directory}"

    if [[ "${1##*/}" != supervisord ]]; then
        log "Warning: FreePBX install is pending and will only run under supervisord."
    fi
fi

# Not needed past this point: keep them out of every service's environment.
unset DBROOT_PASSWORD SMTP_PASSWORD
# supervisord (CMD) starts the services and docker-bootstrap.
exec "$@"
