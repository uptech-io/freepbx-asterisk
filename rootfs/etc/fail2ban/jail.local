[DEFAULT]
bantime.increment = true

findtime = 10m
bantime  = 12h

# Upper limit for bantime.increment.
bantime.maxtime = 1w

ignoreself = true
ignoreip = 127.0.0.1/8 ::1

sender = noc@uptech.com.br

[asterisk]
enabled  = true
filter   = asterisk
logpath  = /usr/local/asterisk/var/log/asterisk/fail2ban
backend  = auto
protocol = tcp,udp
banaction = nftables[type=allports,blocktype=drop]
maxretry = 10
