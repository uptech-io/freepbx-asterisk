[DEFAULT]
bantime.increment = true
bantime.rndtime = 1h

findtime = 10m
bantime  = 12h

# Upper limit for bantime.increment.
bantime.maxtime = 1w

ignoreself = true
ignoreip = 127.0.0.1/8 ::1

banaction = nftables[type=allports,blocktype=drop]
banaction_allports = nftables[type=allports,blocktype=drop]
protocol = tcp,udp

[asterisk]
enabled  = true
filter   = asterisk
logpath  = /usr/local/asterisk/var/log/asterisk/fail2ban
backend  = auto
maxretry = 10
